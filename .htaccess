# ChatBox — root .htaccess for cPanel "document root = project root" installs (Option B).
# The recommended setup is a subdomain whose document root is public/ (Option A); then this
# file is not used at all.
#
# Security model (audit C5): ONLY files that exist inside public/ are ever served directly.
# Every other path (SQL dumps, scratch scripts, vendor/, .env, *.md ...) is sent to Laravel's
# front controller, which answers 404. Nothing outside public/ can be downloaded or executed.

Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header to PHP (Bearer tokens on Apache / cPanel)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block dotfiles and dot-directories everywhere (.env, .git, .htaccess ...), except .well-known
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # Redirect trailing slashes if not a folder inside public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve real files from public/ (widget.js, demo.html, built dashboard assets, ...)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else goes to Laravel — even if a file with that name exists in the project root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/index\.php$
    RewriteRule ^ index.php [L]
</IfModule>

# Defence in depth if mod_rewrite is ever disabled: refuse obviously sensitive file types.
<FilesMatch "(?i)\.(sql|sqlite|db|bak|backup|old|orig|swp|log|md|lock|ya?ml|ini|env|example|sh|phar|dist|cache)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
<FilesMatch "^(artisan|composer\.json|package\.json|phpunit\.xml|vite\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
