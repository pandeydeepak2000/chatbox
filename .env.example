APP_NAME="ChatBox SaaS"
APP_ENV=production
APP_KEY=base64:33Y8D2185Tj90qRj51E2b4aW8FfK3hM9y1X0lVz4A7Q=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# cPanel MySQL Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanel_user_chatbox
DB_USERNAME=cpanel_user_dbuser
DB_PASSWORD=YourStrongPasswordHere

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Real-Time Broadcasting
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=chatbox_app
REVERB_APP_KEY=chatbox_key
REVERB_APP_SECRET=chatbox_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

# Mail (cPanel Webmail / SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=support@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="support@yourdomain.com"
MAIL_FROM_NAME="ChatBox Support"
