# ChatBox — example configuration for cPanel shared hosting.
# Copy to .env and fill in real values ON THE SERVER ONLY. Never commit .env.
# After copying, generate a unique key:  php artisan key:generate

APP_NAME="ChatBox"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chat.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# cPanel compatible drivers (no Redis required)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# No WebSocket server on shared hosting: the widget and dashboard use AJAX polling.
BROADCAST_CONNECTION=null

# Mail (cPanel mailbox SMTP or an external SMTP provider)
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Staff API tokens expire after this many minutes (default 7 days)
SANCTUM_EXPIRATION=10080

# ChatBox
# Allow anyone to register a company from the login page (no e-mail verification yet).
CHATBOX_PUBLIC_REGISTRATION=false
# Extra origins allowed to call the staff API cross-origin (comma separated), e.g. a dev server.
CHATBOX_DASHBOARD_ORIGINS=
CHATBOX_ATTACHMENT_MAX_KB=10240
CHATBOX_ATTACHMENT_LINK_TTL=1440
CHATBOX_DEMO_PROPERTY_KEY=
CHATBOX_DEFAULT_PLAN=pro
